{
    "name": "tollwerk/tw-viewhelpers",
    "type": "typo3-cms-extension",
    "description": "Collection of useful ViewHelpers",
    "license": "MIT",
    "keywords": [
        "typo3"
    ],
    "authors": [
        {
            "name": "Klaus Fiedler",
            "role": "Developer",
            "email": "klaus@tollwerk.de",
            "homepage": "https://tollwerk.de"
        }
    ],
    "homepage": "https://tollwerk.de",
    "support": {
        "issues": "https://github.com/tollwerk/-TYPO3-ext-tw_viewhelpers/issues"
    },
    "require": {
        "php": ">= 8.3",
        "typo3/cms-core": "^14",
        "typo3/cms-fluid-styled-content": "^14"
    },
    "autoload": {
        "psr-4": {
            "Tollwerk\\TwViewhelpers\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "tw_viewhelpers"
        },
        "branch-alias": {
            "dev-master": "14.0.x-dev"
        }
    }
}
